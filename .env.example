# ============================================================
#  LIFEFLOW · Variables de entorno
#  Copia este archivo como .env.local y rellena los valores.
#
#  NUNCA commitees .env.local — está en .gitignore
# ============================================================

# ─── Supabase (requerido) ─────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo en Edge Functions / scripts server-side — NUNCA en el cliente
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── AI Proxy (REQUERIDO para IA real) — claves server-side ─
# Único camino a la IA: mentor, internista, copiloto admin y transcripción
# Whisper. Sin esta variable el mentor usa respuestas pre-programadas (demo).
#
# Ya NO existen EXPO_PUBLIC_{NVIDIA,GROQ,OPENAI}_API_KEY: todo lo EXPO_PUBLIC_*
# se inlinea en el bundle, así que esas claves acababan en el navegador de cada
# usuario, copiables desde devtools y facturables contra la cuenta del dueño.
#
# Secrets en Supabase (Edge Functions → Secrets):
#   ANTHROPIC_API_KEY  (Claude Sonnet 4.6 — primario de Norman)
#   NVIDIA_API_KEY / GROQ_API_KEY / OPENAI_API_KEY (fallback + Whisper)
EXPO_PUBLIC_AI_PROXY_URL=https://[PROJECT_REF].supabase.co/functions/v1/ai-proxy

# ─── Embeddings (para memoria vectorial del mentor) ────────
# Se usa en la Edge Function generate-embeddings (server-side)
OPENAI_API_KEY=sk-...

# ─── Anthropic (opcional — Claude directo) ────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── App ──────────────────────────────────────────────────
EXPO_PUBLIC_APP_URL=https://growthplayers.vercel.app

# ─── RevenueCat (subscripciones) ──────────────────────────
EXPO_PUBLIC_REVENUECAT_KEY=appl_...   # iOS
# EXPO_PUBLIC_REVENUECAT_KEY_ANDROID=goog_...

# ─── Expo Push Notifications ──────────────────────────────
# Configurado automáticamente por Expo — no requiere variable manual.
# Verifica: npx expo credentials:manager

# ─── Wearables OAuth (Oura Ring + WHOOP) ─────────────────
# Origen web canónico. DEBE coincidir carácter a carácter con el redirect URI
# registrado en la consola de cada proveedor y con el que usa la edge function
# sync-wearables: OAuth compara redirect_uri como string exacto.
# Se usa tanto en el cliente (lib/wearables.ts) como en la edge function.
EXPO_PUBLIC_APP_URL=https://growthplayers.vercel.app

# Oura: cloud.ouraring.com/oauth/applications
EXPO_PUBLIC_OURA_CLIENT_ID=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# WHOOP: developer.whoop.com
EXPO_PUBLIC_WHOOP_CLIENT_ID=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# ─── Feature flags ────────────────────────────────────────
# Todos default FALSE si la variable no existe. Ponlos en "true" (literal)
# para activar. Definidos en app/config/env.ts.

# El Círculo: espacios, eventos con RSVP, conexiones, comentarios y reacciones.
# Con esto en false, 12 pantallas muestran "esta sección aún no está activa".
EXPO_PUBLIC_SOCIAL_SPACES_ENABLED=

# Confrontation OS — motor "DIJO vs HIZO". Rollout por cohorte:
# interna → premium_plus+ → resto. La capa IO no consulta nada si está en false.
EXPO_PUBLIC_CONFRONTATION_OS_ENABLED=

# Agregador universal de wearables. Solo en "true" cuando el webhook esté
# provisionado y verificado end-to-end; si no, su CTA "RECOMENDADO" es un
# callejón sin salida. Sin él, las vías reales son OAuth (Oura/WHOOP/Polar)
# y Apple Salud / Health Connect en la app nativa.
EXPO_PUBLIC_AGGREGATOR_ENABLED=
# 'open_wearables' (OSS self-host, default) o 'terra' (comercial, no usado —
# decisión del dueño 2026-09-01: nada de Terra).
EXPO_PUBLIC_AGGREGATOR_VENDOR=

# ─── Supabase CLI (deploy edge functions) ─────────────────
# Genera en: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...
